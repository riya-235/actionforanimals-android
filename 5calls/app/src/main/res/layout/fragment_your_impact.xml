<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Done button at top right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/done_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textSize="16sp"
                android:textColor="@color/colorPrimary"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Header with title and logo like iOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Impact"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_modern" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/afa_stars"
                android:scaleType="fitCenter"
                android:contentDescription="Action for Animals" />

        </LinearLayout>

        <!-- Animals Helped Card with sanctuary background -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Sanctuary background image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sanctuary"
                    android:scaleType="centerInside"
                    android:contentDescription="Sanctuary background" />

                <!-- Text overlay positioned in upper area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animals Helped"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:layout_marginBottom="8dp" />

                    <!-- VStack with negative padding to move number and message closer -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="-15dp">

                        <TextView
                            android:id="@+id/animals_helped_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="56sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="3" />

                        <TextView
                            android:id="@+id/impact_message_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready to make your first impact?"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:gravity="center"
                            android:layout_marginTop="-5dp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- Weekly Streak Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <!-- Weekly Streak Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Weekly Streak"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_modern" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/fire_emoji"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/weekly_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FF7A00" />

                </LinearLayout>

            </LinearLayout>

            <!-- This Week label and Action Status on same line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="This Week"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_modern" />

                <!-- Action Status -->
                <LinearLayout
                    android:id="@+id/action_status_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/green_checkmark_circle"
                        android:src="@drawable/checked_small"
                        android:scaleType="center"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Action completed"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Weekly Calendar Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">

                <!-- Monday -->
                <TextView
                    android:id="@+id/day_monday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="M"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern"
                    android:layout_marginEnd="4dp" />

                <!-- Tuesday -->
                <TextView
                    android:id="@+id/day_tuesday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="T"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern"
                    android:layout_marginEnd="4dp" />

                <!-- Wednesday -->
                <TextView
                    android:id="@+id/day_wednesday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="W"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern"
                    android:layout_marginEnd="4dp" />

                <!-- Thursday -->
                <TextView
                    android:id="@+id/day_thursday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="T"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern"
                    android:layout_marginEnd="4dp" />

                <!-- Friday -->
                <TextView
                    android:id="@+id/day_friday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern"
                    android:layout_marginEnd="4dp" />

                <!-- Saturday -->
                <TextView
                    android:id="@+id/day_saturday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="S"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern"
                    android:layout_marginEnd="4dp" />

                <!-- Sunday -->
                <TextView
                    android:id="@+id/day_sunday"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="S"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/week_day_inactive"
                    android:textColor="@color/text_primary_modern" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- Achievements Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Action Achievements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Action Achievements"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_modern" />

                    <TextView
                        android:id="@+id/action_achievements_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 of 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary_modern" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/action_achievements_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="16dp" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Animal Achievements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Animal Achievements"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_modern" />

                    <TextView
                        android:id="@+id/animal_achievements_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 of 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary_modern" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/animal_achievements_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="16dp" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Milestone Achievements -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Milestone Achievements"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_modern" />

                    <TextView
                        android:id="@+id/milestone_achievements_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 of 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary_modern" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/milestone_achievements_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="16dp" />

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>