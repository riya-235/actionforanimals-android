<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/email_composer_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Issue Title -->
        <TextView
            android:id="@+id/issue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Title"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary_modern"
            android:paddingBottom="16dp"
            android:lineSpacingExtra="2dp" />

        <!-- Contact Card -->
        <LinearLayout
            android:id="@+id/contact_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/contact_card_background"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Contact Photo -->
            <FrameLayout
                android:layout_width="45dp"
                android:layout_height="45dp">

                <ImageView
                    android:id="@+id/contact_icon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/circle_avatar_background"
                    android:scaleType="centerCrop"
                    android:contentDescription="Contact photo" />

                <TextView
                    android:id="@+id/contact_initials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Contact Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/contact_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_modern"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/contact_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_modern"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Email Section -->
        <LinearLayout
            android:id="@+id/email_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Compose Email Button -->
            <TextView
                android:id="@+id/compose_email_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compose_email_button"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="8dp"
                android:background="@drawable/green_outcome_button"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp" />

        </LinearLayout>

        <!-- Email Body Text -->
        <TextView
            android:id="@+id/email_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary_modern"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Action Buttons -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/action_buttons_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
