<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/contact_card_background"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/target_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_person" />

        <!-- Green checkmark overlay for completed targets -->
        <ImageView
            android:id="@+id/target_checkmark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/green_checkmark_circle"
            android:src="@drawable/checked_small"
            android:scaleType="center"
            android:visibility="gone"
            android:contentDescription="Target completed" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/target_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:text="Target Name" />

        <TextView
            android:id="@+id/target_department"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary_modern"
            android:text="Department" />

    </LinearLayout>

</LinearLayout>
