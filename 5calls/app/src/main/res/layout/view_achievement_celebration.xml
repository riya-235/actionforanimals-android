<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Achievement content directly on dark overlay (like iOS) -->
    <LinearLayout
        android:id="@+id/achievement_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp"
        android:gravity="center"
        android:layout_gravity="center">

        <!-- 1. Achievement icon with glow effect (at the top) -->
        <ImageView
            android:id="@+id/achievement_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/badge_first_call"
            android:scaleType="fitCenter"
            android:layout_marginBottom="32dp"
            android:background="@drawable/achievement_icon_glow"
            android:contentDescription="Achievement icon" />

        <!-- 2. "Achievement Unlocked!" text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievement Unlocked!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- 3. Achievement Title (e.g., "Rescue Ally") -->
        <TextView
            android:id="@+id/achievement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rescue Ally"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- 4. Achievement Description (e.g., "3 companion animal actions") -->
        <TextView
            android:id="@+id/achievement_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 companion animal actions"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="2dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

</FrameLayout>